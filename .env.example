# .env
DB_HOST=localhost
POSTGRES_HOST_PORT=15432 # The port on your host machine that maps to the container's 5432 port
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=user_management_db
DB_PORT=${POSTGRES_HOST_PORT} # Use the configurable host port for application connection

# IMPORTANT: dotenv does not expand variables within the .env file.
# You must manually enter the full DATABASE_URL connection string here.
# Example: postgresql://postgres:your_password@localhost:15432/user_management_db?schema=public
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?schema=public

# Application Port
PORT=3000
